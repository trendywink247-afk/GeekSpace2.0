# ============================================================
# GeekSpace 2.0 — Environment Configuration
# Copy to .env and fill in your values:  cp .env.example .env
# ============================================================

# ---- Core ----
NODE_ENV=production
PORT=3001

# ---- Security (REQUIRED in production) ----
# JWT signing secret — generate with: openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRES_IN=7d

# AES encryption key for stored API keys — generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ---- Database ----
DB_PATH=/app/data/geekspace.db

# ---- CORS ----
# Comma-separated allowed origins
CORS_ORIGINS=https://yourdomain.com

# ---- Public URLs ----
PUBLIC_URL=https://yourdomain.com
API_URL=https://yourdomain.com/api

# ---- Ollama (local AI) ----
# Set to your Ollama container name or host address
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_TIMEOUT_MS=120000
OLLAMA_MAX_TOKENS=512

# ---- OpenRouter (cloud AI — optional) ----
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5-20250929
OPENROUTER_TIMEOUT_MS=90000
OPENROUTER_MAX_TOKENS=1024

# ---- OpenRouter Free Tier (fallback — optional) ----
OPENROUTER_FREE_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FREE_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FREE_API_KEY=

# ---- Moonshot Reasoning (heavy tasks — optional) ----
MOONSHOT_REASONING_MODEL=kimi-k2-thinking
MOONSHOT_TIMEOUT_MS=120000
MOONSHOT_MAX_TOKENS=8192

# ---- PicoClaw Sidecar (lightweight local model — optional) ----
PICOCLAW_URL=http://localhost:8080
PICOCLAW_ENABLED=false
PICOCLAW_TIMEOUT_MS=5000

# ---- EDITH / OpenClaw Bridge (optional) ----
# GeekSpace calls the bridge over HTTP; the bridge connects to OpenClaw via WebSocket.
EDITH_GATEWAY_URL=http://edith-bridge:8787
EDITH_TOKEN=
# OpenClaw WebSocket URL (used by the bridge container):
EDITH_OPENCLAW_WS=ws://openclaw:55550
# RPC method name for chat:
OPENCLAW_CHAT_METHOD=chat.completions

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- Telegram Bot (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
RATE_LIMIT_AUTH_MAX=10

# ---- Session ----
SESSION_IDLE_TIMEOUT_MS=1800000

# ---- Request Limits ----
MAX_REQUEST_BODY_BYTES=1048576

# ---- Credits / Billing ----
PREMIUM_MONTHLY_CREDITS=50000
TRIAL_DAYS=3
TRIAL_PREMIUM_CREDITS=10000

# ---- Logging ----
LOG_LEVEL=info

# ---- Demo Data (dev only, ignored in production) ----
SEED_DEMO_DATA=false
