# ════════════════════════════════════════════════════════
# ⚠️  PRODUCTION SECRETS MANAGEMENT
# Real secrets belong in /root/.agentin-secrets (chmod 600).
# This file shows available variables only. Never commit a filled .env.
# See docs/DEPLOYMENT.md → "Secrets Management"
# ════════════════════════════════════════════════════════
# Agentin — Environment Configuration
# Copy to .env and fill in your values:  cp .env.example .env
# ============================================================

# ---- Core ----
NODE_ENV=production
PORT=3001

# ---- Security (REQUIRED in production) ----
# JWT signing secret — generate with: openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRES_IN=7d

# AES encryption key for stored API keys — generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ---- Database ----
DB_PATH=/app/data/geekspace.db

# ---- CORS ----
# Comma-separated allowed origins
CORS_ORIGINS=https://yourdomain.com

# ---- Public URLs ----
PUBLIC_URL=https://yourdomain.com
API_URL=https://yourdomain.com/api

# ---- Ollama (local AI) ----
# Set to your Ollama container name or host address
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_COMPLEX_MODEL=qwen3:14b
OLLAMA_TIMEOUT_MS=90000
OLLAMA_MAX_TOKENS=4096
OLLAMA_THINKING_ENABLED=true

# ---- OpenRouter (cloud AI — optional) ----
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=claude-sonnet-4-6
OPENROUTER_TIMEOUT_MS=90000
OPENROUTER_MAX_TOKENS=1024

# ---- OpenRouter Free Tier (fallback — optional) ----
OPENROUTER_FREE_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FREE_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FREE_API_KEY=

# ---- Moonshot Reasoning (heavy tasks — optional) ----
MOONSHOT_REASONING_MODEL=kimi-k2-thinking
MOONSHOT_TIMEOUT_MS=120000
MOONSHOT_MAX_TOKENS=8192

# ---- Ollama Cloud (remote Ollama-compatible API — optional middle tier) ----
# Use this to add a cloud-hosted Ollama instance as a fallback between
# OpenRouter Free and Edith (Moonshot). Supports Bearer token auth.
# Examples: RunPod, Modal, Vast.ai, or any OpenAI-compatible Ollama endpoint.
OLLAMA_CLOUD_BASE_URL=
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_MODEL=llama3.1:8b
OLLAMA_CLOUD_TIMEOUT_MS=60000

# ---- PicoClaw Sidecar (lightweight local model — optional) ----
PICOCLAW_URL=http://localhost:8080
PICOCLAW_ENABLED=false
PICOCLAW_TIMEOUT_MS=5000
PICO_WORKER_INTERVAL_MS=10000

# Pico-Kimi Bridge (orchestration layer)
BRIDGE_ENABLED=false
BRIDGE_AUTO_ESCALATE=true
BRIDGE_MAX_WORKFLOW_STEPS=6

# ---- [DEPRECATED] EDITH / OpenClaw Bridge ----
# Replaced by direct Moonshot API calls via OpenRouter. Kept for reference only.
# EDITH_GATEWAY_URL=http://edith-bridge:8787
# EDITH_TOKEN=

# ---- Redis ----
REDIS_URL=redis://redis:6379
# Redis password (used in Docker compose — match with REDIS_URL)
REDIS_PASSWORD=

# ---- OpenAI (optional — kept for future use) ----
OPENAI_API_KEY=

# ---- Voice Pipeline (TTS + STT sidecars) ----
# Kokoro TTS — highest quality neural TTS (ONNX, CPU)
KOKORO_TTS_URL=http://kokoro-tts:5101
KOKORO_TTS_ENABLED=true
# Piper TTS — fast CPU-friendly fallback TTS
PIPER_TTS_URL=http://piper-tts:5100
PIPER_TTS_ENABLED=true
# whisper.cpp — local STT (falls back to Groq Whisper if unavailable)
WHISPER_LOCAL_URL=http://whisper-stt:5102
WHISPER_LOCAL_ENABLED=true

# ---- Telegram Bot (optional) ----
# Create a bot via @BotFather on Telegram, then paste the token here.
# The webhook secret is sent by Telegram to verify webhook authenticity.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ---- WhatsApp Business (future — not yet active) ----
# Requires Meta Business verification + WhatsApp Business API access.
WHATSAPP_BUSINESS_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ---- n8n Workflow Automation (optional) ----
# URL of your n8n instance (used for health checks and agentic task routing)
N8N_BASE_URL=http://n8n:5678
# Shared secret for n8n callback webhook authentication
N8N_WEBHOOK_SECRET=

# ---- Docker Tool Services (optional — used by agent tool actions) ----
# crawl4ai: web scraper sidecar (container address on Docker shared network)
CRAWL4AI_URL=http://crawl4ai-ykgs-crawl4ai-1:11235
# Windmill: workflow engine (container address on Docker shared network)
WINDMILL_URL=http://windmill-95s4-windmill_server-1:8000
WINDMILL_TOKEN=

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
RATE_LIMIT_AUTH_MAX=10

# ---- Session ----
SESSION_IDLE_TIMEOUT_MS=1800000

# ---- Request Limits ----
MAX_REQUEST_BODY_BYTES=1048576

# ---- Credits / Billing ----
PREMIUM_MONTHLY_CREDITS=50000
TRIAL_DAYS=3
TRIAL_PREMIUM_CREDITS=10000

# ---- Logging ----
LOG_LEVEL=info

# ---- Resend Email (optional) ----
# Sign up at https://resend.com — free tier supports 3k emails/month
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=agent@agentin.chat

# ---- AgentMail (optional email fallback) ----
# Used when Resend is not configured, or as a delivery fallback
# Sign up at https://agentmail.to
AGENTMAIL_API_KEY=your_agentmail_api_key_here

# ---- Tavily Web Search (optional) ----
# Enables real-time web search for queries about current events
# Sign up at https://tavily.com — free tier available
TAVILY_API_KEY=your_tavily_api_key_here

# ---- Firecrawl Research (optional) ----
# Enables URL scraping and research when users share links
# Sign up at https://firecrawl.dev — free tier available
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ---- Admin Dashboard (api.agentin.chat) ----
# Password for the private admin monitoring dashboard
ADMIN_DASHBOARD_PASSWORD=

# Bearer token for programmatic admin API access (e.g. from monitoring scripts)
ADMIN_TOKEN=

# ---- DevClaw Bridge (admin-only developer API) ----
# GitHub personal access token for creating PRs via `gh` CLI
GITHUB_DEV_TOKEN=
# Timeout for dev runner commands (default 5 minutes)
DEV_RUNNER_TIMEOUT_MS=300000

# ---- Demo Data (dev only, ignored in production) ----
SEED_DEMO_DATA=false

# ---- Image Generation (HuggingFace FLUX fallback) ----
# Free token from https://huggingface.co/settings/tokens
# Required for image generation when Pollinations.AI is unavailable
HF_TOKEN=

# ---- Together AI (paid primary — sign up at api.together.xyz) ----
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.1-70B-Instruct-Turbo
TOGETHER_BASE_URL=https://api.together.xyz/v1
TOGETHER_TIMEOUT_MS=30000
TOGETHER_MAX_TOKENS=2048

# ---- Groq (free tier — Llama 3.3 70B, 14,400 req/day free) ----
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=30000
GROQ_MAX_TOKENS=2048

# ---- Gemini Flash 2.0 (free 1M tokens/day + paid fallback) ----
# ⚠️ Uses functionDeclarations for tools — normalizer handles this
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_TOKENS=2048
