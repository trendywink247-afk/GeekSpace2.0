{
	email admin@agentin.chat
}

(common_headers) {
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}

ai.geekspace.space {
	redir https://ai.agentin.chat{uri} permanent
}

api.geekspace.space {
	redir https://api.agentin.chat{uri} permanent
}

dev.geekspace.space {
	import common_headers

	reverse_proxy openclaw:58049
}

# ---- Production (agentin.chat) ----
ai.agentin.chat {
	import common_headers

	# Admin is api-domain only — hard block on frontend domain
	handle /admin* {
		respond 404
	}

	# API calls always pass through
	handle /api/* {
		reverse_proxy geekspace:3001
	}

	# Gate page is always accessible
	handle /gate.html {
		root * /srv
		file_server
	}

	# Authenticated users (cookie set by gate page) get the SPA
	@agentin_authed expression `{http.request.cookie.gs_auth} == "geekspace-verified-2026"`
	handle @agentin_authed {
		reverse_proxy geekspace:3001
	}

	# Everyone else → gate
	handle {
		redir * /gate.html
	}
}

api.agentin.chat {
	import common_headers

	reverse_proxy geekspace:3001
}

# ---- Staging Environment ----
staging.agentin.chat {
	import common_headers

	# API calls always pass through
	handle /api/* {
		reverse_proxy staging-app:3001
	}

	# Gate page is always accessible
	handle /gate.html {
		root * /srv
		file_server
	}

	# Authenticated users (cookie set by gate page) get the app
	@staging_authed expression `{http.request.cookie.gs_auth} == "geekspace-verified-2026"`
	handle @staging_authed {
		reverse_proxy staging-app:3001
	}

	# Everyone else → gate
	handle {
		redir * /gate.html
	}
}
