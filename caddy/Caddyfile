{
	email admin@agentin.chat
}

(common_headers) {
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-XSS-Protection "0"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' wss: https:; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
	}
}

(static_encode) {
	encode zstd gzip
}

ai.geekspace.space {
	redir https://ai.agentin.chat{uri} permanent
}

api.geekspace.space {
	redir https://api.agentin.chat{uri} permanent
}

# dev.geekspace.space — REMOVED: openclaw container stopped 9 days ago

# ---- Production (agentin.chat) ----
ai.agentin.chat {
	import common_headers

	# Admin is api-domain only — block on frontend domain
	handle /admin* {
		respond 404
	}

	# SSE streams — no compression (breaks EventSource)
	handle /api/agent-state/stream* {
		reverse_proxy geekspace:3001 {
			flush_interval -1
		}
	}
	handle /api/activity/stream* {
		reverse_proxy geekspace:3001 {
			flush_interval -1
		}
	}
	handle /api/health/stream* {
		reverse_proxy geekspace:3001 {
			flush_interval -1
		}
	}

	# API calls — pass through to Express
	handle /api/* {
		reverse_proxy geekspace:3001 {
			flush_interval -1
		}
	}
	handle /preview/* {
		reverse_proxy geekspace:3001
	}

	# Public pages — accessible without auth (for Google verification + SEO)
	@public_pages path / /privacy /terms /login /explore /gate.html
	handle @public_pages {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# Assets: long-lived cache + compression
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		encode zstd gzip
		file_server
	}

	# Authenticated users get the SPA directly from Caddy (no Express redirect issues)
	@agentin_authed expression `{http.request.cookie.gs_auth} == "geekspace-verified-2026"`
	handle @agentin_authed {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# Everyone else → gate
	handle {
		redir * /gate.html
	}
}

api.agentin.chat {
	# Headers handled by Express (helmet) — no common_headers to avoid duplicates

	reverse_proxy geekspace:3001 {
		flush_interval -1
	}
}

# ---- Uptime Kuma (Status Monitoring) ----
status.agentin.chat {
	reverse_proxy uptime-kuma:3001
}

# ---- Staging Environment ----
staging.agentin.chat {
	import common_headers

	# API calls always pass through
	handle /api/* {
		reverse_proxy staging-app:3001 {
			flush_interval -1
		}
	}

	# Gate page is always accessible
	handle /gate.html {
		root * /srv
		file_server
	}

	# Authenticated users (cookie set by gate page) get the app
	@staging_authed expression `{http.request.cookie.gs_auth} == "geekspace-verified-2026"`
	handle @staging_authed {
		reverse_proxy staging-app:3001
	}

	# Everyone else → gate
	handle {
		redir * /gate.html
	}
}
