{
	email admin@agentin.chat
}

(common_headers) {
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}

ai.geekspace.space {
	redir https://ai.agentin.chat{uri} permanent
}

api.geekspace.space {
	redir https://api.agentin.chat{uri} permanent
}

dev.geekspace.space {
	import common_headers

	reverse_proxy openclaw:58049
}

# ---- Production (agentin.chat) ----
ai.agentin.chat {
	import common_headers

	# Admin is api-domain only — block on frontend domain
	handle /admin* {
		respond 404
	}

	# API + preview calls always pass through to Express
	handle /api/* {
		reverse_proxy geekspace:3001
	}
	handle /preview/* {
		reverse_proxy geekspace:3001
	}

	# Public pages — accessible without auth (for Google verification + SEO)
	@public_pages path / /privacy /terms /login /explore /gate.html
	handle @public_pages {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# Assets: long-lived cache
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Authenticated users get the SPA directly from Caddy (no Express redirect issues)
	@agentin_authed expression `{http.request.cookie.gs_auth} == "geekspace-verified-2026"`
	handle @agentin_authed {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# Everyone else → gate
	handle {
		redir * /gate.html
	}
}

api.agentin.chat {
	import common_headers

	reverse_proxy geekspace:3001
}

# ---- Uptime Kuma (Status Monitoring) ----
status.agentin.chat {
	reverse_proxy uptime-kuma:3001
}

# ---- Staging Environment ----
staging.agentin.chat {
	import common_headers

	# API calls always pass through
	handle /api/* {
		reverse_proxy staging-app:3001
	}

	# Gate page is always accessible
	handle /gate.html {
		root * /srv
		file_server
	}

	# Authenticated users (cookie set by gate page) get the app
	@staging_authed expression `{http.request.cookie.gs_auth} == "geekspace-verified-2026"`
	handle @staging_authed {
		reverse_proxy staging-app:3001
	}

	# Everyone else → gate
	handle {
		redir * /gate.html
	}
}
