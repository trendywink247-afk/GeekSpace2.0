{
	email admin@agentin.chat
}

(common_headers) {
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-XSS-Protection "0"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' wss: https:; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
	}
}

(static_encode) {
	encode zstd gzip
}

# ---- Staging / Test (geekspace.space → staging container) ----
ai.geekspace.space {
	import common_headers

	# SSE streams — no compression
	handle /api/agent-state/stream* {
		reverse_proxy staging:3001 {
			flush_interval -1
		}
	}
	handle /api/activity/stream* {
		reverse_proxy staging:3001 {
			flush_interval -1
		}
	}

	# API calls
	handle /api/* {
		reverse_proxy staging:3001 {
			flush_interval -1
		}
	}
	handle /preview/* {
		reverse_proxy staging:3001
	}

	# Public pages
	@staging_public path / /privacy /terms /login /explore /gate.html
	handle @staging_public {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# Assets — no long cache for staging (always fresh)
	handle /assets/* {
		root * /srv
		header Cache-Control "no-cache"
		encode zstd gzip
		file_server
	}

	# Authenticated users
	@geekspace_authed expression `{http.request.cookie.gs_auth} == "{$GATE_COOKIE_VALUE}"`
	handle @geekspace_authed {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# Everyone else → gate
	handle {
		redir * /gate.html
	}
}

api.geekspace.space {
	reverse_proxy staging:3001 {
		flush_interval -1
	}
}

# ---- Production (agentin.chat) ----
ai.agentin.chat {
	import common_headers

	# Admin is api-domain only — block on frontend domain
	# Use route (not handle) so it evaluates in order before auth handlers
	route /admin* {
		respond 403
	}

	# SSE streams — no compression (breaks EventSource)
	handle /api/agent-state/stream* {
		reverse_proxy geekspace:3001 {
			flush_interval -1
		}
	}
	handle /api/activity/stream* {
		reverse_proxy geekspace:3001 {
			flush_interval -1
		}
	}
	handle /api/health/stream* {
		reverse_proxy geekspace:3001 {
			flush_interval -1
		}
	}

	# API calls — pass through to Express
	handle /api/* {
		reverse_proxy geekspace:3001 {
			flush_interval -1
		}
	}
	handle /preview/* {
		reverse_proxy geekspace:3001
	}

	# Public pages — accessible without auth (for Google verification + SEO)
	@public_pages path / /privacy /terms /login /explore /gate.html
	handle @public_pages {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# Assets: long-lived cache + compression
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		encode zstd gzip
		file_server
	}

	# Authenticated users get the SPA directly from Caddy (no Express redirect issues)
	@agentin_authed expression `{http.request.cookie.gs_auth} == "{$GATE_COOKIE_VALUE}"`
	handle @agentin_authed {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# Everyone else → gate
	handle {
		redir * /gate.html
	}
}

api.agentin.chat {
	# Headers handled by Express (helmet) — no common_headers to avoid duplicates

	reverse_proxy geekspace:3001 {
		flush_interval -1
	}
}

# ---- Uptime Kuma (Status Monitoring) ----
status.agentin.chat {
	reverse_proxy uptime-kuma:3001
}

# ---- Staging (staging.agentin.chat → same staging container) ----
staging.agentin.chat {
	import common_headers

	# SSE streams
	handle /api/agent-state/stream* {
		reverse_proxy staging:3001 {
			flush_interval -1
		}
	}
	handle /api/activity/stream* {
		reverse_proxy staging:3001 {
			flush_interval -1
		}
	}

	# API calls
	handle /api/* {
		reverse_proxy staging:3001 {
			flush_interval -1
		}
	}

	# Public pages
	@staging2_public path / /privacy /terms /login /explore /gate.html
	handle @staging2_public {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# Assets
	handle /assets/* {
		root * /srv
		header Cache-Control "no-cache"
		encode zstd gzip
		file_server
	}

	# Authenticated users
	@staging2_authed expression `{http.request.cookie.gs_auth} == "{$GATE_COOKIE_VALUE}"`
	handle @staging2_authed {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# Everyone else → gate
	handle {
		redir * /gate.html
	}
}
