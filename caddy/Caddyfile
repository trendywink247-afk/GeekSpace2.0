{
	email admin@agentin.chat
}

# ---- agentin.chat apex + www → redirect to ai.agentin.chat ----
# Added 2026-04-06. Once Hostinger DNS A records for `agentin.chat` and
# `www.agentin.chat` are pointed at this VPS (72.61.253.224), Caddy will
# provision certs automatically and 308-redirect both to ai.agentin.chat.
agentin.chat, www.agentin.chat {
	redir https://ai.agentin.chat{uri} permanent
}

(common_headers) {
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-XSS-Protection "0"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' wss: https:; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
	}
}

(static_encode) {
	encode zstd gzip
}

# ---- Staging / Test (geekspace.space → staging container) ----
ai.geekspace.space {
	import common_headers

	# SSE streams — no compression
	handle /api/agent-state/stream* {
		reverse_proxy localhost:3002 {
			flush_interval -1
		}
	}
	handle /api/activity/stream* {
		reverse_proxy localhost:3002 {
			flush_interval -1
		}
	}

	# API calls
	handle /api/* {
		reverse_proxy localhost:3002 {
			flush_interval -1
		}
	}
	handle /preview/* {
		reverse_proxy localhost:3002
	}

	# Assets — no long cache for staging (always fresh)
	handle /assets/* {
		root * /srv
		header Cache-Control "no-cache"
		encode zstd gzip
		file_server
	}

	# All other requests → SPA
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

api.geekspace.space {
	reverse_proxy localhost:3002 {
		flush_interval -1
	}
}

# ---- Production (agentin.chat) ----
ai.agentin.chat {
	import common_headers

	# Logo picker — static files, relaxed CSP for external JS
	handle /logo-picker/* {
		root * /srv
		header Cache-Control "no-cache"
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self'"
		file_server
	}

	# Admin is api-domain only — block on frontend domain
	# Use route (not handle) so it evaluates in order before auth handlers
	route /admin* {
		respond 403
	}

	# SSE streams — no compression (breaks EventSource)
	handle /api/agent-state/stream* {
		reverse_proxy geekspace:3001 {
			flush_interval -1
		}
	}
	handle /api/activity/stream* {
		reverse_proxy geekspace:3001 {
			flush_interval -1
		}
	}
	handle /api/health/stream* {
		reverse_proxy geekspace:3001 {
			flush_interval -1
		}
	}

	# API calls — pass through to Express
	handle /api/* {
		reverse_proxy geekspace:3001 {
			flush_interval -1
		}
	}
	handle /preview/* {
		reverse_proxy geekspace:3001
	}

	# Assets: long-lived cache + compression
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		encode zstd gzip
		file_server
	}

	# All other requests → SPA
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

api.agentin.chat {
	# Headers handled by Express (helmet) — no common_headers to avoid duplicates

	# Block admin panel on API domain
	route /admin* {
		respond 403
	}

	reverse_proxy geekspace:3001 {
		flush_interval -1
	}
}

# ---- Uptime Kuma (Status Monitoring) ----
status.agentin.chat {
	reverse_proxy localhost:3100
}

