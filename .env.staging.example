# ============================================================
# GeekSpace 2.0 — Staging Environment Example
# Copy to .env.staging and fill in values
# Generate secrets:
#   openssl rand -hex 64   → JWT_SECRET
#   openssl rand -hex 32   → ENCRYPTION_KEY
#   openssl rand -hex 16   → ADMIN_TOKEN, STAGING_REDIS_PASSWORD
# ============================================================

NODE_ENV=production
PORT=3001

JWT_SECRET=
ENCRYPTION_KEY=
DB_PATH=/app/data/geekspace.db

CORS_ORIGINS=https://staging.agentin.chat
PUBLIC_URL=https://staging.agentin.chat
API_URL=https://staging.agentin.chat

OLLAMA_BASE_URL=http://ollama-qtzz-ollama-1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_MS=120000
OLLAMA_MAX_TOKENS=2048

EDITH_GATEWAY_URL=http://edith-bridge:8787
EDITH_OPENCLAW_WS=ws://openclaw:58049
EDITH_TOKEN=
OPENCLAW_CHAT_METHOD=chat.completions

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://api.moonshot.ai/v1
OPENROUTER_MODEL=kimi-k2.5
OPENROUTER_TIMEOUT_MS=90000
OPENROUTER_MAX_TOKENS=4096

OPENROUTER_FREE_API_KEY=
OPENROUTER_FREE_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FREE_MODEL=meta-llama/llama-3.3-70b-instruct:free

MOONSHOT_REASONING_MODEL=kimi-k2.5
MOONSHOT_TIMEOUT_MS=120000
MOONSHOT_MAX_TOKENS=8192

REDIS_URL=redis://staging-redis:6379
STAGING_REDIS_PASSWORD=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
RATE_LIMIT_AUTH_MAX=10

PREMIUM_MONTHLY_CREDITS=50000
TRIAL_DAYS=3
TRIAL_PREMIUM_CREDITS=10000

JWT_EXPIRES_IN=7d
LOG_LEVEL=debug
SEED_DEMO_DATA=false

PICOCLAW_URL=http://picoclaw:8080
PICOCLAW_ENABLED=true
PICOCLAW_TIMEOUT_MS=15000

BRIDGE_ENABLED=true
BRIDGE_AUTO_ESCALATE=true
BRIDGE_MAX_WORKFLOW_STEPS=6

ADMIN_DASHBOARD_PASSWORD=
ADMIN_TOKEN=
GITHUB_DEV_TOKEN=
