[Unit]
Description=GeekSpace2.0 docker-compose stack auto-start on boot
Documentation=https://github.com/trendywink247-afk/GeekSpace2.0/blob/main/docs/VPS-RECOVERY.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/root/GeekSpace2.0
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300
User=root
Group=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
