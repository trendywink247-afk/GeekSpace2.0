# Secrets — Claude Code must never read these
.env
.env.*
.env.local
.env.staging
.env.production
secrets/
credentials/
*.pem
*.key
*.p12
*.pfx
/root/.agentin-secrets

# Build artifacts — not useful for coding context
node_modules/
dist/
build/
.worktrees/

# Large data files
server/data/*.db
*.sqlite
*.sqlite3
package-lock.json

# Runtime / tool state
tmp-screenshots/
apminsightdata/
.gstack/
.superpowers/

# Logs
logs/
*.log
npm-debug.log*

# Stale docs / audit / reports — not useful for coding context
AGENTIN-MASTER-BRIEF.md
agents/*.yaml
audit/
ops/reports/
docs/internal/audit/
reports/
*.jsonl

# Coverage & test artifacts
coverage/
server/coverage/
playwright-report/
test-results/

# Runtime / pid files
*.pid
.superpowers/
