# alertmanager.yml.telegram-template
#
# This is the TEMPLATE for the Telegram-enabled Alertmanager config.
# The ${TELEGRAM_BOT_TOKEN} and ${TELEGRAM_CHAT_ID} placeholders are
# substituted at container startup via the envsubst entrypoint in docker-compose.yml.
#
# To activate Telegram alerting:
#   1. Set TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID in your environment or a .env file:
#        echo "TELEGRAM_BOT_TOKEN=<your-bot-token>" >> /root/docker/monitoring/.env
#        echo "TELEGRAM_CHAT_ID=<your-chat-id>"     >> /root/docker/monitoring/.env
#   2. Copy this template as alertmanager.yml:
#        cp infra/alertmanager.yml.telegram-template /root/docker/monitoring/alertmanager.yml
#   3. Recreate the alertmanager container (the docker-compose.yml entrypoint
#      will run envsubst before starting alertmanager):
#        cd /root/docker/monitoring && docker compose up -d --force-recreate alertmanager
#
# IMPORTANT: TELEGRAM_CHAT_ID must be a bare integer (e.g. -1001234567890).
# The envsubst will inject it without quotes so YAML parses it as int64.

global:
  resolve_timeout: 5m

route:
  group_by: ['alertname', 'severity']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: 'geekspace-webhook'
  routes:
    - match:
        severity: critical
      receiver: 'telegram-critical'
      continue: true

receivers:
  - name: 'geekspace-webhook'
    webhook_configs:
      - url: 'http://geekspace-app:3001/api/webhooks/prometheus-alert'
        send_resolved: true
        max_alerts: 10

  - name: 'telegram-critical'
    telegram_configs:
      - bot_token: '${TELEGRAM_BOT_TOKEN}'
        chat_id: ${TELEGRAM_CHAT_ID}
        parse_mode: 'HTML'
        message: |-
          {{ if eq .Status "firing" }}🔴 FIRING{{ else }}✅ RESOLVED{{ end }}: <b>{{ .CommonLabels.alertname }}</b>
          Severity: {{ .CommonLabels.severity }}
          {{ range .Alerts -}}
          • {{ .Annotations.summary }}
          {{ if .Annotations.description }}  ↳ {{ .Annotations.description }}
          {{ end -}}
          {{ end }}
        send_resolved: true

inhibit_rules:
  - source_match:
      severity: 'critical'
    target_match:
      severity: 'warning'
    equal: ['alertname', 'instance']
