# AI Security Layer Configuration
# Copy these to your .env file to enable/configure the security layer

# Enable/disable AI security layer (default: true)
AI_SECURITY_ENABLED=true

# Operating mode:
# - log-only: Detect and log violations but don't block (default, safe)
# - sanitize: Remove/replace problematic content and continue
# - block: Reject requests with security violations
AI_SECURITY_MODE=log-only

# Input/output length limits
AI_SECURITY_MAX_INPUT_LENGTH=10000
AI_SECURITY_MAX_OUTPUT_LENGTH=50000

# Block threshold (0.0-1.0): Score at which to take action
# Higher = more strict, Lower = more permissive
AI_SECURITY_THRESHOLD=0.7
